{
  "name": "smart-reading",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first reading knowledge system: library, hybrid search, reader, accepted knowledge with provenance.",
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "npm run build && tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx eval/run.ts",
    "spike": "tsx spike/spike.ts",
    "embeddings:rebuild": "tsx server/cli/rebuild-embeddings.ts",
    "export": "tsx server/cli/export.ts",
    "backup": "tsx server/cli/backup.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "@huggingface/transformers": "^3.5.0",
    "@napi-rs/canvas": "^0.1.100",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.0.0",
    "pdfjs-dist": "^5.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
